body {
    margin: 0;
    font-family: Arial, sans-serif;
    min-height: 100vh;

    background: linear-gradient(
        135deg,
        #87CEEB,
        #E0F7FA,
        #B3E5FC
    );

    color: #123;
}

h1 {
    font-size: 50px;
    margin-bottom: 10px;
}

h2 {
    font-size: 28px;
}

p {
    font-size: 20px;
}

button {
    padding: 15px 30px;
    border: none;
    border-radius: 30px;
    font-size: 18px;
    cursor: pointer;
    background: white;
    color: #1976D2;
    font-weight: bold;
}

button:hover {
    transform: scale(1.05);
}